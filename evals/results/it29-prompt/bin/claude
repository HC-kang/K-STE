#!/usr/bin/env python3
# 25차 판정용 대리 실행 파일. PATH 앞에 두면 동시에 실행되는 claude를 KSTE_SLOTS개(기본 3) 이하로 막는다.
# 잠금 파일 하나를 잡은 채로 진짜 claude(KSTE_REAL_CLAUDE)를 exec한다. 프로세스가 끝나면 잠금이 풀린다.
import fcntl, os, sys, tempfile, time

real = os.environ.get("KSTE_REAL_CLAUDE", os.path.expanduser("~/.local/bin/claude"))
slots = int(os.environ.get("KSTE_SLOTS", "3"))
lock_dir = os.environ.get("KSTE_SLOT_DIR", os.path.join(tempfile.gettempdir(), "kste-it25-slots"))
os.makedirs(lock_dir, exist_ok=True)
while True:
    for i in range(slots):
        fd = os.open(os.path.join(lock_dir, f"slot{i}"), os.O_CREAT | os.O_RDWR)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(fd)
            continue
        os.set_inheritable(fd, True)
        os.execv(real, [real] + sys.argv[1:])
    time.sleep(0.5)
